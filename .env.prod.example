# .env.prod — PRODUÇÃO (inspecao-ocr / v1.2.1). Copie para a VPS em:
#   /opt/apps/inspecao-ocr/.env.prod
# NUNCA versione o .env.prod real. Gere segredos com:  openssl rand -hex 32
#
# ⚠️ GATES DE BOOT (a API RECUSA subir em produção se):
#   - SESSION_SECRET / POSTGRES_PASSWORD forem o default;
#   - PIPELINE_API_KEY ausente;
#   - CORS_ALLOW_ORIGINS == "*";
#   - NENHUMA chave de LLM real (OPENAI_API_KEY/ANTHROPIC_API_KEY) — placeholder derruba o boot.

# ── Aplicação ────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=1.2.1
LOG_LEVEL=INFO

# ── Postgres EXISTENTE na VPS (container postgres16 na rede infra) ──
# Crie o database/usuário no postgres16 antes do 1º deploy:
#   docker exec -it postgres16 psql -U postgres -c "CREATE USER ia_visual WITH PASSWORD '...';"
#   docker exec -it postgres16 psql -U postgres -c "CREATE DATABASE ia_visual OWNER ia_visual;"
POSTGRES_HOST=postgres16
POSTGRES_PORT=5432
POSTGRES_DB=ia_visual
POSTGRES_USER=ia_visual
POSTGRES_PASSWORD=<DEFINIR_SENHA_FORTE_SEM_CARACTERES_ESPECIAIS>

# ── Redis (containerizado neste compose — interno) ───────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Dropbox (LEITURA das imagens dos checklists) ─────────────
DROPBOX_APP_KEY=<SEGREDO:DROPBOX_APP_KEY>
DROPBOX_APP_SECRET=<SEGREDO:DROPBOX_APP_SECRET>
DROPBOX_REFRESH_TOKEN=<SEGREDO:DROPBOX_REFRESH_TOKEN>
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT_PATH=/Sisloc
DROPBOX_REPORTS_PATH=/comparativo_de_imagem
DROPBOX_LOCAL_CACHE_DIR=/tmp/checklists

# ── Provedor de IA ───────────────────────────────────────────
# Precedência é pela CHAVE presente (NÃO por LLM_PROVIDER): se OPENAI_API_KEY
# estiver setada, OpenAI vence. Para usar Anthropic, deixe OPENAI_API_KEY VAZIA.
# Defina de verdade APENAS a chave do provider desejado (gate de boot).
ANTHROPIC_API_KEY=<SEGREDO:ANTHROPIC_API_KEY>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Controle de gasto de LLM (v1.2.1) ────────────────────────
# CRÍTICO: default do código é false → sem isto a esteira INGERE mas NUNCA
# analisa (fila parada, sem erro). Ligue de propósito.
LLM_DISPATCH_ENABLED=true
LLM_MAX_CALLS_PER_RUN=60
LLM_MONTHLY_BUDGET_USD=25.0
CHECKLIST_ANALYSIS_MAX_JOBS_PER_RUN=25

# ── Ingestão agendada de checklists (v1.2.1, cron 30min) ─────
CHECKLIST_INGEST_ENABLED=true
CHECKLIST_INGEST_ROOT=
CHECKLIST_INGEST_SINCE=
CHECKLIST_INGEST_BOOTSTRAP_FULL=false
CHECKLIST_INGEST_MAX_CHECKLISTS=500
CHECKLIST_INGEST_RETRY_DAYS=3
CHECKLIST_BACKFILL_MAX_IDS=20
# Cron antigo de /Avarias (por evento) — desligado por padrão.
AVARIAS_INGEST_ENABLED=false

# ── Sisloc / SQL Server (v1.2.1 — somente leitura, atrás da VPN) ──
# OPCIONAL para o boot (lazy no 1º connect), mas o cron de enriquecimento
# (CHECKLIST_INGEST_ENABLED) chama o Sisloc; sem credenciais + VPN o produto
# não correlaciona com o ERP. Requer rota host(VPS)->10.246.0.15:1433 (VPN
# Tecnogera) e o driver ODBC (já embutido no Dockerfile da v1.2.1).
SISLOC_DB_HOST=10.246.0.15
SISLOC_DB_PORT=1433
SISLOC_DB_NAME=dbsisloc_tecnogera
SISLOC_DB_USER=<SEGREDO:SISLOC_DB_USER>
SISLOC_DB_PASSWORD=<SEGREDO:SISLOC_DB_PASSWORD>
SISLOC_DB_ENCRYPT=yes
# Dívida técnica: true até a CA interna estar na imagem (tráfego cifrado, sem validar identidade).
SISLOC_DB_TRUST_SERVER_CERTIFICATE=true

# ── Segurança (obrigatório em produção) ──────────────────────
SESSION_SECRET=<DEFINIR_SEGREDO_HEX32>
PIPELINE_API_KEY=<DEFINIR_SEGREDO_HEX32>
CORS_ALLOW_ORIGINS=["https://inspecao.polarisprod.com.br"]

# ── Acesso inicial ao portal (seed idempotente no boot) ──────
# Se AMBOS definidos, o boot cria um admin (papel=admin) idempotentemente.
# Alternativa: docker compose exec api python -m app.cli create_user --email <> --password <> --role admin
# Após o 1º login, troque a senha (Usuários → Resetar senha) e REMOVA estas 2 linhas.
INITIAL_ADMIN_EMAIL=admin@tecnogera.com.br
INITIAL_ADMIN_PASSWORD=<DEFINIR_SENHA_FORTE>

# ── Compose (interpolação) ───────────────────────────────────
# Porta reservada na VPS; o Cloudflare Tunnel aponta para inspecao-web:8094.
WEB_PORT=8094
