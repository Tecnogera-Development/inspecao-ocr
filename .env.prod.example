# .env.prod — PRODUÇÃO (inspecao-ocr). Copie para a VPS em:
#   /opt/apps/inspecao-ocr/.env.prod
# NUNCA versione o .env.prod real. Gere segredos com:  openssl rand -hex 32
#
# O boot da API FALHA se SESSION_SECRET/POSTGRES_PASSWORD forem default,
# PIPELINE_API_KEY faltar ou CORS_ALLOW_ORIGINS for '*'.

# ── Aplicação ────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=1.1.0
LOG_LEVEL=INFO

# ── Postgres EXISTENTE na VPS (container postgres16 na rede infra) ──
# NÃO subimos Postgres no compose. Aponte para o banco já existente.
# Crie o database/usuário no postgres16 antes do 1º deploy, ex.:
#   docker exec -it postgres16 psql -U postgres -c "CREATE USER ia_visual WITH PASSWORD '...';"
#   docker exec -it postgres16 psql -U postgres -c "CREATE DATABASE ia_visual OWNER ia_visual;"
POSTGRES_HOST=postgres16
POSTGRES_PORT=5432
POSTGRES_DB=ia_visual
POSTGRES_USER=ia_visual
POSTGRES_PASSWORD=<DEFINIR_SENHA_FORTE>

# ── Redis (containerizado neste compose — interno) ───────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Dropbox (LEITURA das imagens dos checklists) ─────────────
DROPBOX_APP_KEY=<SEGREDO:DROPBOX_APP_KEY>
DROPBOX_APP_SECRET=<SEGREDO:DROPBOX_APP_SECRET>
DROPBOX_REFRESH_TOKEN=<SEGREDO:DROPBOX_REFRESH_TOKEN>
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT_PATH=/Sisloc
DROPBOX_REPORTS_PATH=/comparativo_de_imagem
DROPBOX_LOCAL_CACHE_DIR=/tmp/checklists

# ── Provedores de IA ─────────────────────────────────────────
ANTHROPIC_API_KEY=<SEGREDO:ANTHROPIC_API_KEY>
OPENAI_API_KEY=<SEGREDO:OPENAI_API_KEY>
OPENAI_MODEL=gpt-4.1-mini
# Provider ativo do pipeline: anthropic | openai | fake
LLM_PROVIDER=anthropic

# ── Segurança (obrigatório em produção) ──────────────────────
SESSION_SECRET=<DEFINIR_SEGREDO_HEX32>
PIPELINE_API_KEY=<DEFINIR_SEGREDO_HEX32>
CORS_ALLOW_ORIGINS=["https://inspecao.polarisprod.com.br"]

# ── Acesso inicial ao portal (seed idempotente no boot) ──────
# Após o 1º login, troque a senha e REMOVA estas duas linhas.
INITIAL_ADMIN_EMAIL=admin@tecnogera.com.br
INITIAL_ADMIN_PASSWORD=<DEFINIR_SENHA_FORTE>

# ── Compose (interpolação) ───────────────────────────────────
# Porta reservada na VPS; o Cloudflare Tunnel aponta para inspecao-web:8094.
WEB_PORT=8094
