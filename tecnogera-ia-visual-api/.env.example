# Aplicação
APP_ENV=development
APP_NAME=tecnogera-ia-visual-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ia_visual
POSTGRES_USER=ia_visual
POSTGRES_PASSWORD=changeme

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Dropbox — dois modos:
# (a) PRODUÇÃO: APP_KEY + REFRESH_TOKEN (APP_SECRET opcional p/ apps PKCE).
# (b) TESTE RÁPIDO: ACCESS_TOKEN direto (gerado no console, expira em ~4h).
# Se ACCESS_TOKEN estiver preenchido, ele tem prioridade.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ACCESS_TOKEN=
# Pasta no Dropbox onde estão as imagens dos checklists (LEITURA-ONLY).
# NUNCA escreva nada nesta pasta — é o repositório fonte da Tecnogera.
DROPBOX_ROOT_PATH=/Sisloc
# Pasta no Dropbox onde os relatórios PDF gerados são publicados.
DROPBOX_REPORTS_PATH=/comparativo_de_imagem
# Diretório local (dentro do container) onde imagens baixadas são cacheadas.
DROPBOX_LOCAL_CACHE_DIR=/tmp/checklists

# Provedores de IA
AZURE_CV_ENDPOINT=
AZURE_CV_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Provider decidido para o MVP (preferência da Tecnogera). A escolha efetiva é
# por presença de chave: OpenAI → Anthropic → Fake.
# ⚠ Em APP_ENV=production a API/worker RECUSA subir sem nenhuma das duas chaves:
#   sem chave o provider cai no fake, e laudo fictício na tela do operador é
#   indistinguível de um real. Não há escape hatch (ticket mvp-c54-c57/08).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Pipeline LLM
# LLM_PROVIDER=fake      → modo offline (padrão; não requer chave)
# LLM_PROVIDER=anthropic → chamadas reais (requer ANTHROPIC_API_KEY)
LLM_PROVIDER=fake
LLM_CONFIDENCE_THRESHOLD=0.70
LLM_INCONCLUSIVE_FLOOR=0.40

# ── Freios de gasto de LLM (ticket mvp-c54-c57/08) ────────────────────────────
# A chave da OpenAI é real e paga. Estes três limites são a diferença entre um
# backfill descuidado e uma fatura surpresa. Custo medido: ≈US$ 0,002 por
# imagem, ≈US$ 2/mês no parque projetado (~371 checklists/mês × 3 vistas).
#
# KILL SWITCH. Default false: a esteira sobe ingerindo e materializando jobs
# sem gastar um centavo. Ligue de propósito, quando quiser que ela analise.
LLM_DISPATCH_ENABLED=false
# Teto de chamadas por rodada do cron (30 min). Operação normal usa ~0,8 por
# rodada; 60 é ~75× isso e limita o estrago de um loop a ~US$ 0,12 por rodada.
LLM_MAX_CALLS_PER_RUN=60
# Teto do mês corrente, em USD, comparado ao custo MEDIDO e persistido antes de
# CADA chamada. Estourou, para de despachar. Um backfill dos 18.338 checklists
# com as 4 vistas custaria ~US$ 110 — subir este número é decisão consciente.
LLM_MONTHLY_BUDGET_USD=25.0
# Quantos pipeline_jobs pendentes uma rodada tenta processar.
CHECKLIST_ANALYSIS_MAX_JOBS_PER_RUN=25
PIPELINE_TIMEOUT_SECONDS=1800
# Chave para autenticar o endpoint POST /api/v1/pipeline/run (IAVS-008)
PIPELINE_API_KEY=

# SQL Server do Sisloc (LEITURA-ONLY) — exige VPN da Tecnogera.
# Sem HOST/USER/PASSWORD a integração fica desligada e a API sobe normalmente.
# Ver docs/operations/sql-server.md.
SISLOC_DB_HOST=
SISLOC_DB_PORT=1433
SISLOC_DB_NAME=dbsisloc_tecnogera
SISLOC_DB_USER=
SISLOC_DB_PASSWORD=
# Encrypt=strict NÃO funciona: exige TDS 8.0 / SQL Server 2022+ (o servidor é 2017).
SISLOC_DB_ENCRYPT=yes
# O certificado do servidor não é confiável pela cadeia padrão. Vire para false
# quando a CA interna da Tecnogera estiver na imagem.
SISLOC_DB_TRUST_SERVER_CERTIFICATE=true

# ── Ingestão agendada de checklists (cron 30 min — ticket mvp-c54-c57/07) ─────
# Varre /Sisloc por delta de cursor, filtra formulário ∈ {F180, F038} com
# c54+c55+c56 (c57 opcional) e materializa pipeline_jobs. Somente leitura no
# Dropbox e somente SELECT no SQL Server.
CHECKLIST_INGEST_ENABLED=true
# Vazio herda DROPBOX_ROOT_PATH.
CHECKLIST_INGEST_ROOT=
# Marco de corte por data (YYYY-MM-DD). Vazio = o corte é a própria ativação:
# o bootstrap fixa o cursor no "agora" e o histórico não entra na esteira.
CHECKLIST_INGEST_SINCE=
# true faz o bootstrap listar TODO o histórico (paginado entre rodadas).
# Só para backfill deliberado — a varredura completa de /Sisloc levou 67 min.
CHECKLIST_INGEST_BOOTSTRAP_FULL=false
CHECKLIST_INGEST_MAX_CHECKLISTS=500
CHECKLIST_INGEST_RETRY_DAYS=3

# ── Backfill sob demanda (ticket mvp-c54-c57/11) ──────────────────────────────
# POST /api/v1/checklists/backfill reprocessa checklists antigos por id,
# ignorando o marco de corte. GUARDA-CORPO DE GASTO: cada checklist aceito vira
# 3–4 chamadas de visão no despacho. Aumentar só com o custo em mente.
CHECKLIST_BACKFILL_MAX_IDS=20

# Cron antigo de /Avarias (fluxo por evento, 5 min) — DESLIGADO por decisão do
# ticket mvp-c54-c57/07: saiu do escopo do MVP e disparava LLM sem supervisão.
# O endpoint manual POST /api/v1/events/ingest continua disponível.
AVARIAS_INGEST_ENABLED=false
