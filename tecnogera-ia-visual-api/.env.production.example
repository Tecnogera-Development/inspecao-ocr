# .env de PRODUÇÃO — IA Visual (api FastAPI + worker)
# Copie para  tecnogera-ia-visual-api/.env  e preencha os campos <...>.
# chmod 600 depois de preencher — este arquivo carrega segredos reais.
#
# NOTA: a stack sobe por `docker compose` (ver DEPLOY.md), então POSTGRES_HOST/REDIS_HOST
# usam os nomes de serviço do compose (`postgres`, `redis`) — é o correto neste arranjo.

# ── Aplicação ────────────────────────────────────────────────
APP_ENV=production
APP_NAME=tecnogera-ia-visual-api
APP_VERSION=1.2.1-entregavel
LOG_LEVEL=INFO

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Segurança (OBRIGATÓRIO em produção — o boot FALHA se faltar/for default) ──
# Gere cada um com:  openssl rand -hex 32
SESSION_SECRET=<GERAR_openssl_rand_hex_32>
PIPELINE_API_KEY=<GERAR_openssl_rand_hex_32>
# Origem(ns) permitida(s) no CORS — NÃO pode ser "*" em produção.
CORS_ALLOW_ORIGINS=["https://<dominio-do-portal>"]

# ── Rate limiting de autenticação (NOVO nesta entrega — ticket usuarios-portal/03) ──
# Nenhuma é obrigatória — sem setar, valem os defaults abaixo (já em produção com esses
# valores). Contador em memória do processo: só é exato com a API rodando como processo
# único (ver RELEASE_NOTES.md item 6 e DEPLOY.md).
# POST /login — por e-mail e por origem (CF-Connecting-IP)
LOGIN_RATE_LIMIT_IDENTITY_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_IDENTITY_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ORIGIN_MAX_ATTEMPTS=20
LOGIN_RATE_LIMIT_ORIGIN_WINDOW_SECONDS=900
# POST /definir-senha — protege o código de uso único da janela de primeira senha/reset
PASSWORD_SETUP_RATE_LIMIT_IDENTITY_MAX_ATTEMPTS=5
PASSWORD_SETUP_RATE_LIMIT_IDENTITY_WINDOW_SECONDS=900
PASSWORD_SETUP_RATE_LIMIT_ORIGIN_MAX_ATTEMPTS=20
PASSWORD_SETUP_RATE_LIMIT_ORIGIN_WINDOW_SECONDS=900

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ia_visual
POSTGRES_USER=ia_visual
# Senha forte. Se o banco já existe (atualização, não instalação nova), use a senha
# já configurada — não gere uma nova sem trocar também no Postgres.
POSTGRES_PASSWORD=<DEFINIR_SENHA_FORTE>

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Dropbox — LEITURA das imagens dos checklists (NUNCA escrever em /Sisloc) ──
DROPBOX_APP_KEY=<SEGREDO:DROPBOX_APP_KEY>
DROPBOX_APP_SECRET=<SEGREDO:DROPBOX_APP_SECRET>
DROPBOX_REFRESH_TOKEN=<SEGREDO:DROPBOX_REFRESH_TOKEN>
# ACCESS_TOKEN é opcional (expira em ~4h). Em produção use REFRESH_TOKEN.
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT_PATH=/Sisloc
DROPBOX_REPORTS_PATH=/comparativo_de_imagem
DROPBOX_LOCAL_CACHE_DIR=/tmp/checklists

# ── Provedores de IA ─────────────────────────────────────────
AZURE_CV_ENDPOINT=
AZURE_CV_KEY=
ANTHROPIC_API_KEY=<SEGREDO:ANTHROPIC_API_KEY — alternativa validada, não usada por padrão>
OPENAI_API_KEY=<SEGREDO:OPENAI_API_KEY>
OPENAI_MODEL=gpt-4.1-mini
# ⚠ ATENÇÃO — LLM_PROVIDER NÃO É O QUE LIGA/DESLIGA O PROVIDER.
#   Quem escolhe é a CHAVE PRESENTE, nesta precedência (llm_provider.py:1299):
#       OPENAI_API_KEY preenchida  -> OpenAI
#       senão ANTHROPIC_API_KEY    -> Anthropic
#       senão                      -> Fake (laudo fictício)
#   Setar LLM_PROVIDER=fake com a chave preenchida NÃO desliga o gasto. Para
#   rodar sem gastar (só em ambiente de teste), ZERE as duas chaves.
# ⚠ Em produção (APP_ENV=production) a API/worker RECUSA SUBIR sem nenhuma das
#   duas chaves — guarda-corpo em config.py. Laudo fictício na tela do operador
#   (e no PDF que vai ao cliente, com o logo da Tecnogera) é indistinguível de
#   um laudo real: é o pior modo de falha do projeto.
LLM_PROVIDER=openai

# ── Freios de gasto de LLM ─────────────────────────────────────
# Custo medido: ≈US$ 0,002/imagem. Parque projetado (corte para F038, v1.1): ≈71
# checklists/mês — ≈US$ 0,5/mês.
# KILL SWITCH das análises. O default do CÓDIGO é `false` — com ele desligado a
# esteira ingere e cria os jobs, mas NUNCA dispara análise: tudo fica
# `sem_análise` no portal e o operador vê uma fila que não anda.
# ⚠ PRODUÇÃO EXIGE `true` — é o que faz a análise acontecer em tempo real,
#   junto do CHECKLIST_INGEST_ENABLED=true mais abaixo. São DUAS flags: uma
#   traz o checklist, a outra manda analisar. Ligar só uma não entrega nada.
LLM_DISPATCH_ENABLED=true
LLM_MAX_CALLS_PER_RUN=60
LLM_MONTHLY_BUDGET_USD=25.0
CHECKLIST_ANALYSIS_MAX_JOBS_PER_RUN=25
PIPELINE_TIMEOUT_SECONDS=1800

# ── SQL Server do Sisloc (LEITURA-ONLY) — exige VPN da Tecnogera ─────────────
SISLOC_DB_HOST=<IP-do-SQL-Server>
SISLOC_DB_PORT=1433
SISLOC_DB_NAME=dbsisloc_tecnogera
SISLOC_DB_USER=<SEGREDO:SISLOC_DB_USER>
SISLOC_DB_PASSWORD=<SEGREDO:SISLOC_DB_PASSWORD>
SISLOC_DB_ENCRYPT=yes
SISLOC_DB_TRUST_SERVER_CERTIFICATE=true

# ── Ingestão agendada de checklists (cron 30 min) ─────────────────────────────
# O formulário-alvo (F038) NÃO é configurável por env var — é a constante
# FORMULARIOS_ALVO em app/services/checklist_filter.py (decisão da v1.1).
CHECKLIST_INGEST_ENABLED=true
CHECKLIST_INGEST_ROOT=
CHECKLIST_INGEST_SINCE=
CHECKLIST_INGEST_BOOTSTRAP_FULL=false
CHECKLIST_INGEST_MAX_CHECKLISTS=500
CHECKLIST_INGEST_RETRY_DAYS=3

# ── Backfill sob demanda ───────────────────────────────────────────────────
CHECKLIST_BACKFILL_MAX_IDS=20

# Cron antigo de /Avarias (fluxo por evento, 5 min) — DESLIGADO por padrão.
AVARIAS_INGEST_ENABLED=false
