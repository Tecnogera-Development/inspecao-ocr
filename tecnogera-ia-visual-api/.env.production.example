# .env de PRODUÇÃO — inspecao / IA Visual (api FastAPI + worker)
# Copie para  tecnogera-ia-visual-api/.env  e preencha os campos <...>.
# Os valores <SEGREDO:...> serão enviados pela equipe da Polaris por canal seguro.

# ── Aplicação ────────────────────────────────────────────────
APP_ENV=production
APP_NAME=tecnogera-ia-visual-api
APP_VERSION=1.1.0
LOG_LEVEL=INFO

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ia_visual
POSTGRES_USER=ia_visual
# Senha forte — gravada no volume postgres_data no PRIMEIRO `up`.
# Definir ANTES de subir; trocar depois exige recriar o volume.
POSTGRES_PASSWORD=<DEFINIR_SENHA_FORTE>

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Dropbox (LEITURA das imagens dos checklists) ─────────────
DROPBOX_APP_KEY=<SEGREDO:DROPBOX_APP_KEY>
DROPBOX_APP_SECRET=<SEGREDO:DROPBOX_APP_SECRET>
DROPBOX_REFRESH_TOKEN=<SEGREDO:DROPBOX_REFRESH_TOKEN>
# ACCESS_TOKEN é opcional (expira em ~4h). Em produção use REFRESH_TOKEN.
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT_PATH=/Sisloc
DROPBOX_REPORTS_PATH=/comparativo_de_imagem
DROPBOX_LOCAL_CACHE_DIR=/tmp/checklists

# ── Provedores de IA ─────────────────────────────────────────
AZURE_CV_ENDPOINT=
AZURE_CV_KEY=
ANTHROPIC_API_KEY=<SEGREDO:ANTHROPIC_API_KEY>
OPENAI_API_KEY=<SEGREDO:OPENAI_API_KEY>
OPENAI_MODEL=gpt-4.1-mini
# Provider ativo do pipeline: anthropic | openai | fake
LLM_PROVIDER=anthropic

# ── Segurança (obrigatório em produção) ──────────────────────
# O boot FALHA se qualquer um destes estiver com valor inseguro/ausente.
# Gere segredos com:  openssl rand -hex 32
SESSION_SECRET=<DEFINIR_SEGREDO_HEX32>
PIPELINE_API_KEY=<DEFINIR_SEGREDO_HEX32>
# Origens permitidas do portal (NUNCA use '*' em produção).
CORS_ALLOW_ORIGINS=["https://portal.tecnogera.com.br"]

# ── Acesso inicial ao portal ─────────────────────────────────
# Criado automaticamente no boot se ainda não existir (idempotente).
# Alternativa manual:  docker compose exec api python -m app.cli create_user ...
# IMPORTANTE: após o 1º login, troque a senha e REMOVA estas duas linhas.
INITIAL_ADMIN_EMAIL=admin@tecnogera.com.br
INITIAL_ADMIN_PASSWORD=<DEFINIR_SENHA_FORTE>
